publishedAt: "2026-08-29T14:22:00.455Z"
category: "Naujienos"
featuredImage: "@assets/images/posts/grizimas-i-lietuvos-seimos-gydytoja-po-jk-ar-jav-kaip-prisirasyti-ka-tureti-ir-k/featuredImage.png"
